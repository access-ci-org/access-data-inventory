Table sds_software_discovery_service {
  rps json [note: 'access: Restricted | Request param: array of Resource Provider names/IDs to filter by, case-insensitive. Conditional (rps and/or software).']
  software json [note: 'access: Restricted | semantic: entity_name | Request param: array of software names to filter by, case-insensitive. Conditional (rps and/or software).']
  columns json [note: 'access: Restricted | Request param: array of fields to return. rp_software and software_name are always included.']
  exclude boolean [note: 'access: Restricted | Request param: when true, treat columns as an exclude list rather than an include list. Default false.']
  fuzz_software boolean [note: 'access: Restricted | Request param: enable fuzzy matching on software names. Default false.']
  fuzz_rp boolean [note: 'access: Restricted | Request param: enable fuzzy matching on RP names/IDs. Default false.']
  collapse_resource_groups boolean [note: 'access: Restricted | Request param: when false, emit separate entries per resource group. Default true.']
  software_name varchar [not null, note: 'access: Restricted | semantic: entity_name | Response field: name of the software package. Results are sorted alphabetically by this field.']
  rp_software varchar [not null, note: 'access: Restricted | Response field: the software identifier as known to the resource provider. Always present in responses.']
  resource_provider varchar [note: 'access: Restricted | semantic: institution | Response field: resource provider / resource group the software is available on.']

  Note: '''
    source: sds_software_discovery_service
    description: Software discovery: which software packages are available on which ACCESS resource providers.
    access_level: Public
  '''
}

